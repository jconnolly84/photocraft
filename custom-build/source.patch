-/// Hex sha256 of a corpus file (reused by every corpus fetch, `xtask/pixls.sha256` included).
-fn file_hex(path: &std::path::Path) -> Option<String> {
-    std::fs::read(path).ok().map(|b| crate::sha256::hex(&b))
-}
