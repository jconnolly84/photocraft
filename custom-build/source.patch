-    fn collect(&self, dir: &Path, base: &Path, out: &mut Vec<PathBuf>) {
-        let mut visited = std::collections::HashSet::new();
-        let mut dirs = 0usize;
-        self.collect_inner(dir, base, out, &mut visited, &mut dirs);
-    }
