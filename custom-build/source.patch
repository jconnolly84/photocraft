-                std::fs::create_dir_all(parent).map_err(|e| format!("create {}: {e}", parent.display()))?;
-            }
-            if copy {
-                std::fs::copy(from, to).map(|_| ()).map_err(|e| format!("copy {}: {e}", from.display()))
-            } else {
-                std::fs::rename(from, to).map_err(|e| format!("move {}: {e}", from.display()))
