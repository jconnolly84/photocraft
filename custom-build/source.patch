diff --git a/apps/photocraft-web/src/browser_background.rs b/apps/photocraft-web/src/browser_background.rs
new file mode 100644
index 0000000..e7ca72a
--- /dev/null
+++ b/apps/photocraft-web/src/browser_background.rs
@@ -0,0 +1,75 @@
+//! Async on-device model bridge. No image is uploaded; the host worker returns a mask.
+use std::cell::{Cell, RefCell};
+use js_sys::{Function, Object, Reflect, Uint8Array};
+use wasm_bindgen::{JsCast, JsValue};
+use wasm_bindgen_futures::JsFuture;
+use photocraft_codecs::{ChannelLayout, EncodeOptions, Image};
+use photocraft_doc::Document;
+use photocraft_ui_egui::PhotocraftApp;
+
+struct Outcome { document: u64, revision: u64, layer: u64, bounds: [i32; 4], result: Result<Vec<u8>, String> }
+thread_local! {
+    static BUSY: Cell<bool> = const {Cell::new(false)};
+    static DONE: RefCell<Vec<Outcome>> = const {RefCell::new(Vec::new())};
+    static WAKE: RefCell<Option<egui::Context>> = const {RefCell::new(None)};
+}
+fn error(value: JsValue) -> String {value.as_string().unwrap_or_else(|| format!("{value:?}"))}
+fn parent_function(name: &str) -> Result<(web_sys::Window, Function), String> {
+    let host = web_sys::window().ok_or("no browser window")?.parent().map_err(error)?.ok_or("no host window")?;
+    let function = Reflect::get(&host, &JsValue::from_str(name)).map_err(error)?.dyn_into::<Function>().map_err(|_| "AI background removal is unavailable in this host")?;
+    Ok((host, function))
+}
+pub fn start(doc: &Document, layer: u64, revision: u64) -> Result<(), String> {
+    if BUSY.with(Cell::get) {return Err("Background removal is already running. Use Cancel in the toolbar to stop it.".into());}
+    let target = doc.layer(photocraft_doc::LayerId(layer)).ok_or("select an image layer")?;
+    let surface = target.surface().ok_or("The image is not rendered yet. Try again after it loads.")?;
+    let area = surface.content_bounds().intersect(&doc.bounds());
+    let count = u64::from(area.width()) * u64::from(area.height());
+    if area.is_empty() || count > 16_777_216 {return Err("AI background removal supports image layers up to 16 megapixels. Resize the image first.".into());}
+    let mut pixels = vec![[0u8; 4]; count as usize];
+    surface.read_rgba8_into(area, &mut pixels);
+    let image = Image::from_u8(area.width(), area.height(), ChannelLayout::Rgba, pixels.into_iter().flatten().collect()).map_err(|e| e.to_string())?;
+    let png = photocraft_codecs::encode(&image, photocraft_codecs::Format::Png, &EncodeOptions::default()).map_err(|e| e.to_string())?;
+    let (host, function) = parent_function("photocraftRemoveBackground")?;
+    let object = Object::new();
+    Reflect::set(&object, &JsValue::from_str("png"), &Uint8Array::from(png.as_slice())).map_err(error)?;
+    let promise = js_sys::Promise::resolve(&function.call1(&host, &object).map_err(error)?);
+    let document = doc.id.0;
+    let bounds = [area.x0, area.y0, area.width() as i32, area.height() as i32];
+    BUSY.with(|busy| busy.set(true));
+    wasm_bindgen_futures::spawn_local(async move {
+        let result = async {
+            let value = JsFuture::from(promise).await.map_err(error)?;
+            let bytes: Uint8Array = value.dyn_into().map_err(|_| "Invalid model mask bytes")?;
+            if u64::from(bytes.length()) != count {return Err("Model mask dimensions do not match the image".into());}
+            Ok(bytes.to_vec())
+        }.await;
+        DONE.with(|done| done.borrow_mut().push(Outcome {document, revision, layer, bounds, result}));
+        BUSY.with(|busy| busy.set(false));
+        // A completed promise can arrive between idle logic ticks. Wake a real
+        // UI paint instead of waiting for another mouse or keyboard event.
+        WAKE.with(|wake| {
+            if let Some(ctx) = wake.borrow().as_ref() {ctx.request_repaint();}
+        });
+    });
+    Ok(())
+}
+pub fn poll(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    WAKE.with(|wake| *wake.borrow_mut() = Some(ctx.clone()));
+    for outcome in DONE.with(|done| std::mem::take(&mut *done.borrow_mut())) {
+        let result = outcome.result.and_then(|alpha| photocraft_engine::cutout_cmds::apply_model_mask(&mut app.session, outcome.document, outcome.revision, outcome.layer, outcome.bounds, alpha).map_err(|e| e.to_string()));
+        let (message, success) = match result {
+            Ok(()) => ("Background removed locally. Undo restores the original.".to_string(), true),
+            Err(reason) => (format!("Background was not changed: {reason}"), false),
+        };
+        app.ui.status = message.clone();
+        app.ui.status_error = !success;
+        // Session edits happen in logic; request the next UI pass explicitly
+        // so the changed document revision reaches the canvas immediately.
+        ctx.request_repaint();
+        if let Ok((host, function)) = parent_function("photocraftBackgroundComplete") {
+            let _ = function.call1(&host, &JsValue::from_str(&message));
+        }
+    }
+    if BUSY.with(Cell::get) {ctx.request_repaint_after(std::time::Duration::from_millis(100));}
+}
diff --git a/apps/photocraft-web/src/browser_recovery.rs b/apps/photocraft-web/src/browser_recovery.rs
new file mode 100644
index 0000000..839560c
--- /dev/null
+++ b/apps/photocraft-web/src/browser_recovery.rs
@@ -0,0 +1,117 @@
+//! Local-only recovery and clipboard services for the school browser host.
+use std::sync::{Arc, Mutex, PoisonError};
+use js_sys::{Array, Function, Object, Reflect, Uint8Array};
+use wasm_bindgen::{JsCast, JsValue};
+use wasm_bindgen_futures::JsFuture;
+use photocraft_ui_egui::{Recoverable, Services};
+const MAX_BYTES: u32 = 64 * 1024 * 1024;
+type Outcomes = Vec<(u64, u64, Result<(), String>)>;
+struct Entry { key: String, name: String, path: Option<String>, bytes: Vec<u8> }
+#[derive(Default)]
+struct State { entries: Vec<Entry>, outcomes: Outcomes }
+#[derive(Clone, Default)]
+pub struct Bridge(Arc<Mutex<State>>);
+fn js(error: JsValue) -> String { error.as_string().unwrap_or_else(|| format!("{error:?}")) }
+fn invoke(name: &str, argument: &JsValue) -> Result<js_sys::Promise, String> {
+    let host = web_sys::window().ok_or("no browser window")?.parent().map_err(js)?.ok_or("no host window")?;
+    let function: Function = Reflect::get(&host, &JsValue::from_str(name)).map_err(js)?.dyn_into().map_err(|_| "host feature unavailable")?;
+    let value = function.call1(&host, argument).map_err(js)?;
+    Ok(js_sys::Promise::resolve(&value))
+}
+fn field(value: &JsValue, name: &str) -> Result<JsValue, String> { Reflect::get(value, &JsValue::from_str(name)).map_err(js) }
+fn set(object: &Object, name: &str, value: &JsValue) -> Result<(), String> {
+    Reflect::set(object, &JsValue::from_str(name), value).map_err(js).map(|_| ())
+}
+pub async fn load() -> Option<Bridge> {
+    let promise = invoke("photocraftRecoveryLoad", &JsValue::NULL).ok()?;
+    let value = match JsFuture::from(promise).await {
+        Ok(value) => value,
+        Err(error) => { log::warn!("Browser recovery unavailable: {}", js(error)); return None; }
+    };
+    if !Array::is_array(&value) { return None; }
+    let values = Array::from(&value);
+    if values.length() > 16 { return None; }
+    let mut entries = Vec::new();
+    let mut total = 0u64;
+    for value in values.iter() {
+        let record = (|| -> Result<Entry, String> {
+            let key = field(&value, "key")?.as_string().ok_or("missing recovery key")?;
+            let name = field(&value, "name")?.as_string().ok_or("missing document name")?;
+            if key.len() > 256 || name.len() > 1024 { return Err("recovery metadata too long".into()); }
+            let data: Uint8Array = field(&value, "bytes")?.dyn_into().map_err(|_| "invalid snapshot bytes")?;
+            if data.length() > MAX_BYTES { return Err("recovery snapshot too large".into()); }
+            total = total.saturating_add(u64::from(data.length()));
+            if total > 128 * 1024 * 1024 { return Err("recovery data exceeds memory budget".into()); }
+            Ok(Entry { key, name, path: field(&value, "path")?.as_string(), bytes: data.to_vec() })
+        })();
+        match record { Ok(entry) => entries.push(entry), Err(error) => log::warn!("Recovery entry skipped: {error}") }
+    }
+    Some(Bridge(Arc::new(Mutex::new(State {entries, outcomes: Vec::new()}))))
+}
+pub fn attach(services: &mut Services, bridge: Option<Bridge>) {
+    let Some(bridge) = bridge else { return };
+    let saves = bridge.clone();
+    services.autosave = Some(Box::new(move |doc, revision, path| {
+        let bytes = photocraft_format::save_to_bytes(doc, &Default::default()).map_err(|error| error.to_string())?;
+        if bytes.len() > MAX_BYTES as usize { return Err("Recovery snapshot exceeds 64 MiB; download a .pcraft copy".into()); }
+        let object = Object::new();
+        set(&object, "docId", &JsValue::from_str(&doc.id.0.to_string()))?;
+        set(&object, "revision", &JsValue::from_str(&revision.to_string()))?;
+        set(&object, "name", &JsValue::from_str(&doc.name))?;
+        set(&object, "path", &path.map(JsValue::from_str).unwrap_or(JsValue::NULL))?;
+        set(&object, "bytes", &Uint8Array::from(bytes.as_slice()))?;
+        let promise = invoke("photocraftRecoverySave", &object)?;
+        let state = saves.clone();
+        let id = doc.id.0;
+        wasm_bindgen_futures::spawn_local(async move {
+            let result = JsFuture::from(promise).await.map(|_| ()).map_err(js);
+            state.0.lock().unwrap_or_else(PoisonError::into_inner).outcomes.push((id, revision, result));
+        });
+        Ok(())
+    }));
+    let results = bridge.clone();
+    services.autosave_results = Some(Box::new(move || {
+        std::mem::take(&mut results.0.lock().unwrap_or_else(PoisonError::into_inner).outcomes)
+    }));
+    services.recover = Some(Box::new(move || {
+        std::mem::take(&mut bridge.0.lock().unwrap_or_else(PoisonError::into_inner).entries)
+            .into_iter().map(|entry| Recoverable {
+                key: entry.key, name: entry.name, path: entry.path,
+                load: Box::new(move || photocraft_format::load_from_bytes(&entry.bytes).map_err(|error| error.to_string())),
+            }).collect()
+    }));
+    services.discard_autosave = Some(Box::new(|id| {
+        if let Ok(promise) = invoke("photocraftRecoveryDiscard", &JsValue::from_str(&id.to_string())) {
+            wasm_bindgen_futures::spawn_local(async move { let _ = JsFuture::from(promise).await; });
+        }
+    }));
+    services.adopt_autosave = Some(Box::new(|id, key| {
+        let object = Object::new();
+        if set(&object, "docId", &JsValue::from_str(&id.to_string())).is_err() || set(&object, "key", &JsValue::from_str(key)).is_err() { return; }
+        if let Ok(promise) = invoke("photocraftRecoveryAdopt", &object) {
+            wasm_bindgen_futures::spawn_local(async move { let _ = JsFuture::from(promise).await; });
+        }
+    }));
+}
+pub fn write_clipboard(bytes: &[u8]) -> Result<(), String> {
+    let promise = invoke("photocraftClipboardWrite", &Uint8Array::from(bytes))?;
+    wasm_bindgen_futures::spawn_local(async move {
+        if let Err(error) = JsFuture::from(promise).await { log::warn!("Browser clipboard write failed: {}", js(error)); }
+    });
+    Ok(())
+}
+
+/// Start the host's asynchronous clipboard read while the menu click is active.
+/// Returning false leaves PhotoCraft's native editable clipboard route intact.
+pub fn paste_clipboard() -> Result<bool, String> {
+    let host = web_sys::window().ok_or("no browser window")?.parent().map_err(js)?.ok_or("no host window")?;
+    let value = Reflect::get(&host, &JsValue::from_str("photocraftBrowserPaste")).map_err(js)?;
+    let Ok(function) = value.dyn_into::<Function>() else { return Ok(false) };
+    function.call0(&host).map_err(js).map(|value| value.as_bool().unwrap_or(false))
+}
+
+pub fn start_action(action: &str) -> Result<(), String> {
+    let promise = invoke("photocraftStartAction", &JsValue::from_str(action))?;
+    wasm_bindgen_futures::spawn_local(async move {let _ = JsFuture::from(promise).await;});
+    Ok(())
+}
