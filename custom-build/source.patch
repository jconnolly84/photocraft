+        fetch_pngsuite_in(
+            &f.0,
+            "unused",
+            &fixture_manifest(),
+            |_| Err("offline".into()),
+            |_, _| panic!("failed download extracted"),
+            |_, _| panic!("failed download installed")
+        )
+        .unwrap_err()
+        .contains("offline")
+    );
+    f.assert_old_cache();
+    assert!(
+        fetch_pngsuite_in(
+            &f.0,
