-struct Opts {
-    quick: bool,
-    update_baseline: bool,
-    threshold: Option<f64>,
-    benches: Vec<String>,
-    skip_build: bool,
-    reuse: bool,
-    /// `--update-baseline --from`: build the baseline from these saved `results.json` files.
-    from: Vec<PathBuf>,
-    allow_contended: bool,
-}
