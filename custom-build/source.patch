+            fixture_download,
+            |_, files| {
+                std::fs::write(files.join("partial.png"), b"partial").unwrap();
+                Err("extract failed".into())
+            },
+            |_, _| panic!("failed extraction installed")
+        )
+        .unwrap_err()
+        .contains("extract failed")
