-impl Scenario {
-    pub fn target_text(&self) -> String {
-        if let Some(t) = &self.target {
-            return t.clone();
-        }
-        match self.budget_ms {
-            Some(b) if b.fract() == 0.0 => format!("≤ {b:.0} ms {}", self.metric.label()),
-            Some(b) => format!("≤ {b} ms {}", self.metric.label()),
-            None => "track only".into(),
-        }
