-                Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
-                Err(e) => return Err(format!("create {}: {e}", path.display())),
-            }
-        }
-        Err("pngsuite: could not create a staging directory".into())
-    }
-}
