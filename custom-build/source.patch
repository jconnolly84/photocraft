-    /// Replaces `dest` with the files (from `locate`) plus extras, moved or copied.
-    fn install(
-        &self,
-        files: &[(String, String)],
-        locate: impl Fn(&str) -> Option<PathBuf>,
-        extras: &[(PathBuf, String)],
-        copy: bool,
-        note: &str,
-    ) -> Result<(), String> {
