-            .iter()
-            .filter_map(|(hash, file)| match locate(file).map(std::fs::read) {
-                Some(Ok(bytes)) if sha256::hex(&bytes) == *hash => None,
-                Some(Ok(_)) => Some(format!("{file}: sha256 mismatch")),
-                _ => Some(format!("{file}: missing")),
